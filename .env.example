# Run commands from the repository root with: uv run --env-file .env ...
PYTHONPATH=src:.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# PostgreSQL in Docker, accessed from the host.
POSTGRES_PASSWORD=paymenthub
DATABASE_URL=postgresql+psycopg://paymenthub:${POSTGRES_PASSWORD}@localhost:5432/paymenthub
DATABASE_POOL_SIZE=5

# MongoDB in Docker, accessed from the host.
MONGO_URI=mongodb://localhost:27017
MONGO_VN_DATABASE=paymenthub_vn
MONGO_INDIA_DATABASE=paymenthub_india
MONGO_ASIA_ID_DATABASE=paymenthub_asia_id
MONGO_ASIA_PH_DATABASE=paymenthub_asia_ph
MONGO_VN_COLLECTION=payment_transactions
MONGO_ASIA_COLLECTION=payment_transactions
MONGO_INDIA_COLLECTION=payment_transactions
MONGO_VN_TIMEZONE=Asia/Ho_Chi_Minh
MONGO_INDIA_TIMEZONE=Asia/Kolkata
MONGO_ASIA_ID_TIMEZONE=Asia/Jakarta
MONGO_ASIA_PH_TIMEZONE=Asia/Manila

# Optional local demo data generator.
GENERATOR_SEED=20260923
RECORDS_PER_REGION=5000
GROUND_TRUTH_PATH=tests/generated/ground_truth.json
PROVIDER_STATEMENTS_DIR=tests/generated/provider-statements

# Optional observability services in the full Docker Compose setup.
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
