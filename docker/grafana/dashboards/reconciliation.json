        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Run ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open run detail",
                    "url": "/d/paymenthub-reconciliation-api?var-run_id=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "COMPLETED": {
                        "color": "green",
                        "index": 0
                      },
                      "FAILED": {
                        "color": "red",
                        "index": 1
                      },
                      "PENDING": {
                        "color": "yellow",
                        "index": 2
                      },
                      "RUNNING": {
                        "color": "blue",
                        "index": 3
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Source file"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Action"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "actions"
                }
              },
              {
                "id": "actions",
                "value": [
                  {
                    "type": "infinity",
                    "title": "Delete",
                    "confirmation": "Delete run ${__value.raw} and all its provider rows, results and job log? This cannot be undone. Only completed or failed runs can be deleted.",
