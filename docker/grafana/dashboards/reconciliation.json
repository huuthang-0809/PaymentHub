                      "backgroundColor": "#E02F44"
                    },
                    "infinity": {
                      "url": "http://api:8000/reconciliation-runs/${__value.raw}",
                      "method": "DELETE",
                      "headers": [
                        [
                          "Prefer",
                          "return=representation"
                        ]
                      ],
                      "body": "",
                      "queryParams": [],
                      "datasourceUid": "reconciliation-api"
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.filterable",
                "value": false
              }
            ]
          }
        ]
