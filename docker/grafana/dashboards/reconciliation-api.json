      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Current Prometheus alerts in firing state.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 0,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 1},
      "id": 12,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "vertical", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "wideLayout": true},
      "targets": [
        {"editorMode": "code", "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)", "instant": true, "legendFormat": "Firing alerts", "range": false, "refId": "A"}
      ],
      "title": "Firing alerts",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Pending and firing Prometheus alert instances. Use the Alerting workspace link for silences and routing details.",
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": true}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "alertstate"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "mappings", "value": [{"options": {"firing": {"color": "red", "index": 0}, "pending": {"color": "yellow", "index": 1}}, "type": "value"}]}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "severity"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-text"}},
              {"id": "mappings", "value": [{"options": {"critical": {"color": "red", "index": 0}, "warning": {"color": "orange", "index": 1}}, "type": "value"}]}
            ]
          }
        ]
      },
      "gridPos": {"h": 5, "w": 20, "x": 4, "y": 1},
      "id": 13,
      "options": {"cellHeight": "sm", "enablePagination": true, "footer": {"countRows": true, "fields": "", "reducer": ["sum"], "show": true}, "showHeader": true},
      "targets": [
        {"editorMode": "code", "expr": "ALERTS{alertstate=~\"pending|firing\"}", "format": "table", "instant": true, "legendFormat": "{{alertname}}", "range": false, "refId": "A"}
      ],
      "title": "Active alerts",
      "type": "table"
    },
